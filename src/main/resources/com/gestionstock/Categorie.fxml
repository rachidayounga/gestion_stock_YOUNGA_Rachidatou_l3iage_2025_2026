<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestionstock.controller.CategorieController">
    <children>
        <HBox prefHeight="40.0" prefWidth="200.0" spacing="10.0">
            <children>
                <TextField fx:id="champRecherche" onKeyReleased="#rechercherCategories" promptText="Rechercher" />
            </children>
        </HBox>
        <TableView fx:id="tableCategories" prefHeight="280.0" prefWidth="560.0">
            <columns>
                <TableColumn fx:id="colonneNom" prefWidth="140.0" text="Nom" />
                <TableColumn fx:id="colonneDescription" prefWidth="180.0" text="Description" />
                <TableColumn fx:id="colonneNbProduits" prefWidth="140.0" text="Nb. produits rattachés" />
                <TableColumn fx:id="colonneActions" prefWidth="100.0" text="Actions" />
            </columns>
        </TableView>
        <HBox prefHeight="60.0" prefWidth="200.0" spacing="10.0">
            <children>
                <TextField fx:id="champNom" promptText="Nom" />
                <TextField fx:id="champDescription" promptText="Description" />
                <Button fx:id="boutonEnregistrer" mnemonicParsing="false" onAction="#enregistrerCategorie" text="Enregistrer" />
            <Button fx:id="boutonAnnuler" layoutX="333.0" layoutY="10.0" mnemonicParsing="false" onAction="#annulerModification" text="Enregistrer" />
            </children>
        </HBox>
    </children>
</VBox>
