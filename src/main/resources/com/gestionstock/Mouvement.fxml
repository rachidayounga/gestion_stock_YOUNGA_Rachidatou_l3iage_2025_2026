<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="680.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.MouvementController"
>
    <children>
        <HBox prefHeight="40.0" prefWidth="200.0" spacing="10.0">
            <children>
                <TextField fx:id="champRecherche" onKeyReleased="#rechercherMouvements" prefWidth="300.0" promptText="Rechercher (produit)" />
                <Button fx:id="boutonNouveauMouvement" onAction="#ouvrirDialogAjout" mnemonicParsing="false" prefWidth="150.0" styleClass="btn-primaire" text="+ Nouveau Mouvement" />
            </children>
        </HBox>
        <TableView fx:id="tableMouvements" prefWidth="720.0">
            <columns>
                <TableColumn fx:id="colonneDate" prefWidth="140.0" text="Date" />
                <TableColumn fx:id="colonneProduit" prefWidth="180.0" text="Produit" />
                <TableColumn fx:id="colonneType" prefWidth="90.0" text="Type" />
                <TableColumn fx:id="colonneQuantite" prefWidth="80.0" text="Quantité" />
                <TableColumn fx:id="colonneMotif" prefWidth="220.0" text="Motif" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>